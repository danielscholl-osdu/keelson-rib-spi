{
  "schema": 1,
  "lanes": 5,
  "noise": [
    {
      "id": "license-cla-app-authored",
      "check": "license/cla",
      "author": "app",
      "reason": "never completes on PRs an app opened; not a required check"
    },
    {
      "id": "docker-build-skipped",
      "check": "Docker Build",
      "conclusion": "skipped",
      "reason": "skipped by design on the pull_request_target lane and on fork_upstream; the pull_request lane builds the image"
    }
  ],
  "failures": [
    {
      "id": "environment-maintenance",
      "pattern": "in maintenance",
      "class": "environment",
      "response": "wait",
      "rerunLimit": 0,
      "drainFirst": false
    },
    {
      "id": "environment-not-deployable",
      "pattern": "(environment is not deployable|pin still refused) after 10 minutes",
      "class": "environment",
      "response": "rerun-failed",
      "rerunLimit": 1,
      "drainFirst": true,
      "source": "https://github.com/Azure/osdu-spi/pull/272"
    },
    {
      "id": "digest-not-live",
      "pattern": "digest not live after 15 minutes",
      "class": "environment",
      "response": "rerun-failed",
      "rerunLimit": 1,
      "drainFirst": true,
      "source": "https://github.com/Azure/osdu-spi/pull/284"
    },
    {
      "id": "image-lock-race",
      "pattern": "could not update osdu-image-lock",
      "class": "environment",
      "response": "rerun-failed",
      "rerunLimit": 1,
      "drainFirst": false,
      "source": "https://github.com/Azure/osdu-spi-stack/issues/400"
    },
    {
      "id": "pin-refused-moved-tag",
      "pattern": "re-run all jobs in the workflow run",
      "class": "environment",
      "response": "rerun-all",
      "rerunLimit": 1,
      "drainFirst": false,
      "source": "https://github.com/Azure/osdu-spi-stack/pull/461"
    }
  ],
  "unmatched": {
    "class": "real",
    "response": "stop"
  },
  "ordering": [
    {
      "service": "search",
      "after": ["storage", "indexer"],
      "reason": "the search suites read records through storage and the indexer",
      "source": "https://github.com/Azure/osdu-spi/pull/284"
    }
  ]
}
